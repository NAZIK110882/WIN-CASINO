# Скопіюйте у .env (файл .env НЕ комітити!) і змініть значення.
# production на сервері
APP_ENV=development

# --- MySQL ---
DB_HOST=db
DB_PORT=3306
DB_NAME=casino_db
DB_USER=casino
DB_PASS=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
DB_CONNECT_TIMEOUT=3
DB_READ_TIMEOUT=5
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_MS=100
DB_LOCK_WAIT_TIMEOUT=5

# --- Безпека ---
# Згенерувати: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters_xxxxxxxx
JWT_TTL=3600
SEED_PLAYER_PASSWORD=change_me_player_pw
SEED_ADMIN_PASSWORD=change_me_admin_pw

# --- CORS: origin(и) фронтенду через кому ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Rate limiting ---
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
LOGIN_RATE_MAX=5
# true, якщо бекенд за Caddy/Nginx
TRUSTED_PROXY=false

# --- Кеш ---
# redis | file
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_USER=30
CACHE_TTL_LEADERBOARD=30

# --- Circuit Breaker / Timeout ---
CB_FAILURE_THRESHOLD=5
CB_OPEN_SECONDS=15
REQUEST_TIMEOUT=10

# --- Версіювання ---
# API_V1_SUNSET=Wed, 31 Dec 2026 23:59:59 GMT

# --- Фронтенд-контейнер ---
API_BASE_URL=http://localhost:8000/api
API_VERSION=v1

# --- Docker Hub / production ---
DOCKERHUB_USER=your_dockerhub_login
IMAGE_TAG=latest
APP_DOMAIN=casino.example.com
API_DOMAIN=api.casino.example.com
