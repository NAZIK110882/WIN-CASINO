{
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit -c phpunit.xml",
        "test:integration": "php -d extension=pdo_sqlite -d extension=sqlite3 vendor/bin/phpunit -c phpunit.integration.xml"
    }
}
